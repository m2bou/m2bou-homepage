{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "m2bou-homepage",

  "main": "./worker.js",

  "compatibility_date": "2026-07-10",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/posts",
      "/posts/*",
      "/test"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "POSTS",
      "id": "d82b77b8ad1541da8831a2145dfdac91"
    }
  ],

  "compatibility_flags": [
    "nodejs_compat"
  ]
}